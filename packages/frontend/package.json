{
  "name": "@twikee/frontend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/twikee.umd.js",
  "module": "./dist/twikee.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/twikee.es.js",
      "require": "./dist/twikee.umd.js",
      "default": "./dist/twikee.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "vite build -c vite.site.config.ts && cp -r dist/* dist-site/ 2>/dev/null || true",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@twikee/core": "workspace:*",
    "@vueuse/core": "^11.0.0",
    "blobatar": "^0.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-vue-next": "^0.460.0",
    "marked": "^14.0.0",
    "radix-vue": "^1.9.0",
    "tailwind-merge": "^2.5.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.2.0",
    "vue-tsc": "^2.2.0"
  }
}
