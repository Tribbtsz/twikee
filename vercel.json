{
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm -F @twikee/frontend exec vite --host 127.0.0.1",
  "buildCommand": "pnpm -F @twikee/core build && pnpm -F @twikee/api build && pnpm -F @twikee/frontend build && pnpm -F @twikee/frontend build:site",
  "outputDirectory": "packages/frontend/dist-site",
  "headers": [
    {
      "source": "/twikee.umd.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...slug]"
    },
    {
      "source": "/health",
      "destination": "/api/[...slug]"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
