# 本地开发 (使用本地 SQLite 文件)
TURSO_DATABASE_URL=file:./data/twikee.db
TURSO_AUTH_TOKEN=

# 生产环境 (Turso 云数据库)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

TWIKEE_SECRET=

# CORS 白名单（逗号分隔，多个前端站点用逗号隔开）
# 留空 = 允许所有来源（默认，适合纯自用/公开展示）；
# 生产建议配置为实际嵌入评论的站点，例如:
# CORS_ORIGIN=https://blog.example.com,https://notes.example.com
CORS_ORIGIN=

# Token 有效期（毫秒），默认 7 天 = 604800000
# TWIKEE_TOKEN_TTL=604800000

# 通知配置 (在管理后台 /admin 设置，以下为 DB 配置键名)
# NOTIFICATION_ENABLE=true
# NOTIFICATION_TYPE=wxpusher  # telegram | webhook | email | wxpusher | wecom
# Telegram: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# WxPusher (https://wxpusher.zjiecode.com): WXPUSHER_APP_TOKEN / WXPUSHER_UIDS
# 企业微信群机器人: WECOM_KEY
# 邮件 (Resend): SMTP_FROM / SMTP_TO / SMTP_PASS
