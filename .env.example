# 本地开发 (使用本地 SQLite 文件)
TURSO_DATABASE_URL=file:./data/twikee.db
TURSO_AUTH_TOKEN=

# 生产环境 (Turso 云数据库)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

TWIKEE_ADMIN_PASSWORD=
TWIKEE_SECRET=

# 通知配置 (在管理后台 /admin 设置，以下为 DB 配置键名)
# NOTIFICATION_ENABLE=true
# NOTIFICATION_TYPE=wxpusher  # telegram | webhook | email | wxpusher | wecom
# Telegram: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# WxPusher (https://wxpusher.zjiecode.com): WXPUSHER_APP_TOKEN / WXPUSHER_UIDS
# 企业微信群机器人: WECOM_KEY
# 邮件 (Resend): SMTP_FROM / SMTP_TO / SMTP_PASS
